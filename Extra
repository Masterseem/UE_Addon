local function Shoot_Target(target)
    if not target then return end
    if not getCharacter(target) then return end

    local TargetCharacter = getCharacter(target)
    local Target_Part = Selected_Part
    if not TargetCharacter["HumanoidRootPart"] or not TargetCharacter["Head"] or not Target_Part then return end

    local TargetRoot = TargetCharacter["HumanoidRootPart"]
    local TargetHead = TargetCharacter["Head"]
    
    local status = api:get_status_cache(target)
    if status["Grabbed"] or status["SDeath"] or status["Dead"] then
        return
    end

    task.wait(0.1)

    if not HasTool(getPlayer(), "[Rifle]") then
        Library:Notify("You don't have a Rifle", 2)
        return
    end

    EquipTool("[Rifle]")

    local Position = TargetCharacter[Target_Part].Position + Vector3.new(0, Stomp_Offset, 0)
    local Destination
    if status["K.O"] then
        if not Auto_Stomp then
            return
        end
        
        Destination = CFrame.new(Position, Position + TargetRoot.CFrame.LookVector)
    else
        Destination = TargetRoot.CFrame * CFrame.new(0, 10, 0)
    end

    if Desync then
        api:set_desync_cframe(Destination)
    else
        Teleport(Destination)
    end
    
    local MyCharacter = getCharacter()
    if not MyCharacter then return end

    local MyRoot = getRoot(MyCharacter)
    if not MyRoot then return end

    local Tool = MyCharacter:FindFirstChildOfClass("Tool")
    if not Tool then return end

    local Handle = Tool:FindFirstChild("Handle")
    if not Handle then return end

    --if not api:can_desync() then return end

    task.wait(0.1)

    api:force_shoot(Handle, TargetHead, MyRoot.Position, TargetHead.Position, true)
end

