local function GetTargetState(status)
    if not status then
        return "UNKNOWN"
    end

    if status["Grabbed"] then
        return "GRABBED"
    end

    if status["SDeath"] then
        return "SDEATH"
    end

    if status["K.O"] then
        return "KO"
    end

    if status["Reload"] then
        return "RELOADING"
    end

