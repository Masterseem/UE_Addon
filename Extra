local function Do_Kill_Command(target, stomp, loopCount)
    if not target then return end

    local function isDead(status)
        return status and status["Dead"]
    end

    local function isSDeath(status)
        return status and status["SDeath"]
    end

    local function isGrabbed(status)
        return status and status["Grabbed"]
    end

    print("Starting auto kill")

    -- KILL PHASE
    local i = 0

    while task.wait(1) do
        i += 1

        local char = getCharacter(target)
        if not char then print("Coudn't find Character") return end

        local root = getRoot(char)
        local Head = char:FindFirstChild("Head")
        local part = char:FindFirstChild(Selected_Part)

        --if not root or not head or not part then return end

        if not root then
            warn("No HumanoidRootPart")
            return
        end

        if not Head then
            warn("No Head")
            return
        end

        if not part then
            warn("No selected part:", Selected_Part)
            return
        end

        local status = api:get_status_cache(target)
        if not status then return end

        if isDead(status) then break end

        if isGrabbed(status) then break end

        if loopCount and i > loopCount then break end

        local destination

        print("Teleporting to player")

        if status["K.O"] then
            if not stomp then
                break
            end

            local pos = part.Position + Vector3.new(0, Stomp_Offset, 0)
            destination = CFrame.new(pos, pos + root.CFrame.LookVector)
        else
            destination = root.CFrame * CFrame.new(0, 10, 0)
        end

        print("Teleporting:", destination)

        if Desync then
            print("Using desync")
            api:set_desync_cframe(destination)
        else
            print("Teleporting")
            Teleport(destination)
        end

        task.wait(0.1)

        local myChar = getCharacter()
        local myRoot = myChar and getRoot(myChar)

        if myChar and myRoot then
            local tool = myChar:FindFirstChildOfClass("Tool")
            local handle = tool and tool:FindFirstChild("Handle")

            if handle then
                api:force_shoot(handle, Head, myRoot.Position, Head.Position, true)
            end
        end
    end

    -- STOMP FINISH
    if not stomp then return end

    while task.wait(1) do
        local char = getCharacter(target)
        if not char then return end

        local root = getRoot(char)
        local BodyPart = char:FindFirstChild("UpperTorso")
        if not root or not BodyPart then return end

        local status = api:get_status_cache(target)
        if not status then return end

        print("Starting stomp stage")

        if isSDeath(status) then
            return
        end

        if isGrabbed(status) then
            return
        end

        local pos = BodyPart.Position + Vector3.new(0, Stomp_Offset, 0)
        --local destination = CFrame.new(pos, pos + root.CFrame.LookVector)
        local destination = CFrame.new(pos)

        if Desync then
            api:set_desync_cframe(destination)
        else
            Teleport(destination)
        end
    end
end

