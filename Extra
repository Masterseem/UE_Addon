    DetachFromTarget()

    local targetList = {}
    for name, enabled in pairs(SelectedPlayers) do
        if enabled then
            table.insert(targetList, name)
        end
    end

    if #targetList == 0 then
        return
    end

    LastTargetIndex = LastTargetIndex + 1
    if LastTargetIndex > #targetList then
        LastTargetIndex = 1
    end

    local name = targetList[LastTargetIndex]
    local player = Players:FindFirstChild(name)

    if player then
        Shoot_Target(player)
    else
        table.remove(targetList, LastTargetIndex)
        LastTargetIndex = LastTargetIndex - 1
    end
end

